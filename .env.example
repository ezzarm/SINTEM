APP_NAME=Sintem
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sintem
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# FIX: Use 'lax' not 'strict'. Strict blocks session cookies on form-based POST 
# navigations from the same site, causing CSRF token mismatch (500 errors).
SESSION_SAME_SITE=lax

CACHE_STORE=database

BCRYPT_ROUNDS=12
